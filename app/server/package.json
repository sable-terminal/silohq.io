{
  "name": "@silo/server",
  "version": "0.0.0",
  "private": true,
  "description": "Silo cell services",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.ts",
    "db:up": "docker compose up -d --wait db pgbouncer",
    "db:down": "docker compose down",
    "infra:up": "docker compose up -d --wait redis nats vault s3 pubsub gcs",
    "sources:up": "docker compose --profile sources up -d --wait mysql mssql oracle",
    "db:bootstrap": "node src/db/scripts/bootstrapLocal.script.ts",
    "db:migrate": "node src/db/scripts/migrate.script.ts cell",
    "db:migrate:directory": "node src/db/scripts/migrate.script.ts directory",
    "db:partitions": "node src/db/scripts/maintainPartitions.script.ts",
    "db:models": "node src/db/scripts/generateModels.script.ts",
    "provision": "node src/db/scripts/provision.script.ts",
    "fleet:agent-binary": "node src/scripts/putAgentBinary.script.ts",
    "fleet:release-document": "node src/scripts/putReleaseDocument.script.ts",
    "fleet:load-bundle": "node src/scripts/loadBundle.script.ts",
    "fleet:templates": "node src/scripts/conceptTemplates.script.ts",
    "test:db": "node --test --test-concurrency=1 'tests/db/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 'tests/**/*.test.ts'",
    "test:unit": "node --test 'tests/utils/**/*.test.ts' 'tests/config/**/*.test.ts' 'tests/schemas/**/*.test.ts' 'tests/contracts/**/*.test.ts' 'tests/architecture/**/*.test.ts'",
    "test:infra": "node --test --test-concurrency=1 'tests/infra/**/*.test.ts'"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "@deck.gl/core": "9.4.1",
    "@deck.gl/layers": "9.4.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@google-cloud/bigquery": "9.3.0",
    "@google-cloud/kms": "^6.3.0",
    "@google-cloud/pubsub": "^6.3.2",
    "@google-cloud/storage": "^8.4.0",
    "@marcbachmann/cel-js": "8.0.0",
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "@node-saml/node-saml": "5.1.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@opentelemetry/semantic-conventions": "^1.44.0",
    "@peculiar/x509": "2.2.0",
    "@simplewebauthn/server": "14.0.3",
    "express": "5.3.0",
    "fast-xml-parser": "5.12.1",
    "graphene-pk11": "^2.3.6",
    "graphql": "17.0.2",
    "hyparquet": "1.31.4",
    "hyparquet-writer": "0.16.12",
    "jsonata": "2.2.2",
    "meshoptimizer": "1.3.0",
    "msgpackr": "2.1.0",
    "nodemailer": "10.1.7",
    "openid-client": "6.8.8",
    "pg": "^8.23.1",
    "pmtiles": "4.5.0",
    "redis": "^6.3.1",
    "reflect-metadata": "0.2.2",
    "ssh2": "1.17.0",
    "ws": "8.22.0",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.23.1",
    "@types/ssh2": "1.15.6",
    "@types/ws": "8.18.2",
    "typescript": "^7.0.2",
    "xml-crypto": "6.4.0"
  }
}
