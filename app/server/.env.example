# Local development values for the containers started by `npm run db:up` and
# `npm run infra:up`. Real cells get these from Fleet: configuration as environment
# variables, secrets as files (NAME_FILE). Never commit real credentials.

# Migration and local bootstrap (src/db/scripts only; services never read these).
LOCAL_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:55432/postgres
CELL_MIGRATE_URL=postgres://postgres:postgres@127.0.0.1:55432/silo_cell
DIRECTORY_MIGRATE_URL=postgres://postgres:postgres@127.0.0.1:55432/silo_directory

# The process and its cell (src/config/service.config.ts, cell.config.ts).
SILO_ENV=development
SILO_SERVICE=gateway
SILO_CELL_ID=uk-lon-1
SILO_CELL_KIND=commercial
SILO_RESIDENCY=uk
SILO_HOSTING=gke
SILO_BUILD_TARGET=commercial

# Stores. A service logs in as its own member login, never postgres or a migration login,
# and reaches Postgres through PgBouncer in transaction mode (port 56432, spec 8.2).
# Migration URLs above go to Postgres directly (55432): migrations need a session.
# npm run db:bootstrap creates one login per service, password 'local': svc_auth,
# svc_credential, svc_app, svc_audit, svc_model_gateway, svc_outbox_relay, svc_maintenance,
# svc_billing, svc_catalogue_migrate; in the directory database svc_directory, svc_status and
# svc_fleet_control (status and fleet-control use theirs for PG_DIRECTORY_URL). Run each
# service with its own, for example
#   SILO_SERVICE=auth PG_CONTROL_URL=postgres://svc_auth:local@127.0.0.1:56432/silo_cell npm start
PG_CONTROL_URL=postgres://svc_app:local@127.0.0.1:56432/silo_cell
PG_DIRECTORY_URL=postgres://svc_app:local@127.0.0.1:56432/silo_directory
REDIS_SESSION_URL=redis://127.0.0.1:56379/0
REDIS_DATA_URL=redis://127.0.0.1:56379/1
REDIS_STATE_URL=redis://127.0.0.1:56379/2
# A Redis command fails after this rather than waiting, so an outage is a cache miss or
# a refusal, never a hung request.
REDIS_COMMAND_TIMEOUT_MS=2000

# Buses.
NATS_LIVE_URL=nats://127.0.0.1:54222
DURABLE_BUS=jetstream

# Keys, for the credential service: a local key, development and tests only (production
# uses Cloud KMS or the UK HSM). Generate one with `openssl rand -base64 32`, then register
# it: npm run provision -- key --provider local --key-uri local:dev
# Vault transit also works locally (KMS_PROVIDER=vault_transit, VAULT_ADDR, VAULT_TOKEN)
# once its key exists; the dev root token bypasses vault/credential.policy.hcl.
# An HSM over PKCS#11 (KMS_PROVIDER=pkcs11_hsm): PKCS11_MODULE_PATH, PKCS11_PIN, and the slot
# by PKCS11_SLOT or PKCS11_TOKEN_LABEL. The sovereign cell's Thales Luna takes
# PKCS11_PROFILE=luna with the partition's (or HA group's) PKCS11_TOKEN_LABEL and the
# partition's Crypto User PIN; key URIs are pkcs11:object=<label> (D206).
KMS_PROVIDER=local
KMS_LOCAL_KEY=

# Auth: keys the hashes of client addresses and email addresses (openssl rand -base64 32).
# BREACH_LIST_DIR holds the Pwned Passwords range files; without it, new passwords are
# not checked (development only; production refuses to start).
IDENTIFIER_HASH_KEY=
# BREACH_LIST_DIR=/path/to/pwned-passwords

# Object storage (S3-compatible locally).
OBJECT_STORE=s3
OBJECT_BUCKET_FILES=silo-files
S3_ENDPOINT=http://127.0.0.1:58333
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local-secret

# To run as a commercial cell against the emulators instead (npm run infra:up starts them):
# DURABLE_BUS=pubsub
# PUBSUB_PROJECT_ID=silo-local
# PUBSUB_EMULATOR_HOST=127.0.0.1:58085
# OBJECT_STORE=gcs
# GCS_EMULATOR_ENDPOINT=http://127.0.0.1:54443

# The service shell. Locally each service runs on its own port and names the others'
# addresses; in a cell they are reached at SERVICE_URL_TEMPLATE over mTLS.
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
HTTP_DRAIN_SECONDS=0
# Load shedding (spec 12.4): the event-loop delay (ms) the lowest class is shed from, and each step to the next.
# SHED_START_MS=200  SHED_STEP_MS=50
# SERVICE_URL_AUTH=http://127.0.0.1:8081
SERVICE_URL_CREDENTIAL=http://127.0.0.1:8082

# SERVICE_URL_POLICY=http://127.0.0.1:8083

# Gateway: the public edge. The origin browsers load the app from; TLS files in production.
# GATEWAY_PUBLIC_ORIGIN=https://localhost:8443
# GATEWAY_PUBLIC_PORT=8443
# GATEWAY_TLS_CERT_FILE= / GATEWAY_TLS_KEY_FILE=
# The web client's static export, served at the public origin beside /api/v1 (npm run build in app/web):
# GATEWAY_WEB_ROOT=../web/out
# The object store's origins a large upload goes to from the browser (signed URLs): added to the pages' connect-src.
# GATEWAY_UPLOAD_ORIGINS=https://storage.googleapis.com
# GATEWAY_REQUESTS_PER_ADDRESS=3000  GATEWAY_REQUESTS_PER_SESSION=600  GATEWAY_REQUESTS_PER_ORGANISATION=30000  GATEWAY_SOCKETS_PER_SESSION=8

# Notify: the SMTP relay inside the cell, and where links point. Notify also takes executed
# Actions from bus-durable (DURABLE_BUS above) and delivers outbound Action events through
# the same egress as connectors (CONNECT_EGRESS_* below): HTTPS endpoints, public addresses.
# SMTP_HOST=127.0.0.1
# SMTP_PORT=2525
# SMTP_TLS=none
# NOTIFY_FROM_ADDRESS=no-reply@silo.local
# NOTIFY_FROM_NAME=Silo
# NOTIFY_LINK_BASE_URL=https://localhost:8443

# Maintenance: its own migration login, refused in any process hosting other services.
# MAINTENANCE_DATABASE_URL=postgres://svc_maintenance:local@127.0.0.1:55432/silo_cell

# Connect: the OAuth callback; private addresses and plain HTTP are for local fakes only
# (production refuses both).
# OAUTH_REDIRECT_URI=https://localhost:8443/connect/oauth/   (the web client's return page)
# CONNECT_EGRESS_ALLOW_PRIVATE=true
# CONNECT_EGRESS_ALLOW_HTTP=true
# The cell's own networks (nodes, pods, services, managed Postgres and Redis), which no
# Enterprise private link may overlap and the egress never reaches. Required in production
# for credential and connect-registry. Not the Private Service Connect endpoint subnet.
# CONNECT_CELL_NETWORKS=10.0.0.0/16,10.8.0.0/14,10.12.0.0/20

# The Silo Agent endpoint (connect-runtime, spec 10.2): agent.<cell> behind a TCP pass-through
# load balancer. Unset certificate and CA: no agent endpoint. The CA key is P-256 PKCS#8 PEM
# from the deployment; the code never generates it. AGENT_RELAY_URL is this replica's own
# address on the service listener (https://$(POD_IP):<HTTP_PORT>), where other replicas relay
# work for the agents it holds; unset, it relays to others but holds work for none of theirs.
# AGENT_ENDPOINT_HOST=agent.uk-lon-1.silohq.io
# AGENT_ENDPOINT_PORT=8443
# AGENT_ENDPOINT_TLS_CERT_FILE=/etc/silo/agent-endpoint.pem
# AGENT_ENDPOINT_TLS_KEY=-----BEGIN PRIVATE KEY-----...
# AGENT_CA_CERT_FILE=/etc/silo/agent-ca.pem
# AGENT_CA_KEY=-----BEGIN PRIVATE KEY-----...
# AGENT_RELAY_URL=https://10.8.1.23:8080
# Execution grants (spec 10.4): actions signs every write through the Silo Agent; connect-runtime
# checks the grant and gives the public key to every agent it enrols. Ed25519, from the
# deployment; both required in production where those services run.
# EXECUTION_GRANT_KEY=-----BEGIN PRIVATE KEY-----...
# EXECUTION_GRANT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----...
# Discovery scans (spec 10.5): discovery signs every scan the Silo Agent runs; connect-runtime
# checks it and gives the public key to every agent it enrols. A key pair of its own, never the
# execution grant key. Both required in production where those services run; none in the
# sovereign build, which has no discovery.
# DISCOVERY_SCAN_KEY=-----BEGIN PRIVATE KEY-----...
# DISCOVERY_SCAN_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----...
# Agent updates (spec 10.7, 11.4): connect-runtime takes the agent releases the cell's Fleet agent
# carries in, checked with the Silo release key (FLEET_RELEASE_PUBLIC_KEY_FILE) and served from
# OBJECT_BUCKET_FILES. Silo's own organisations here are the first wave (none: it passes at once);
# each wave soaks this long.
# CONNECT_AGENT_FIRST_ORGANISATIONS=
# CONNECT_AGENT_WAVE_SOAK_HOURS=24

# SSO: the flow lifetime, the redirect the provider returns to, the SAML entity id and the
# WebAuthn relying party name. Auth also needs GATEWAY_PUBLIC_ORIGIN for both; credential
# needs KMS_DIRECTORY_KEY_URI and DIRECTORY_KEY_VERSION to compute directory hashes, and
# registers people with the directory only when SERVICE_URL_DIRECTORY is set.
# SSO_FLOW_SECONDS=600
# SSO_OIDC_REDIRECT_URI=https://localhost:8443/sso/callback
# SSO_SAML_ENTITY_ID=https://localhost:8443/saml
# WEBAUTHN_RP_NAME=Silo

# Catalogue: Silo staff paths run on their own migration login; releases are Ed25519-signed.
# CATALOGUE_DATABASE_URL=postgres://svc_catalogue_migrate:local@127.0.0.1:55432/silo_cell
# CATALOGUE_RELEASE_PUBLIC_KEY_FILE=

# Live state: the gateway reaches the state plane for subscriptions and change-stream for
# webhook intake. Resolution takes request bodies up to 16 MiB, so its process raises
# HTTP_MAX_BODY_BYTES.
# SERVICE_URL_STATE_PLANE=http://127.0.0.1:8090
# SERVICE_URL_CHANGE_STREAM=http://127.0.0.1:8091

# Scheduler and files. The files process raises HTTP_MAX_BODY_BYTES to about 8 MiB for
# base64 downloads. The gateway reaches canvas-layout and studio at their own addresses.
# SCHEDULER_TICK_MS=15000  SCHEDULER_BATCH=50  SCHEDULER_MIN_INTERVAL_MINUTES=15  SCHEDULER_CONCURRENCY=4
# FILES_MAX_EXPORT_BYTES=5242880  FILES_EXPORT_RETENTION_DAYS=  FILES_SWEEP_SECONDS=3600
# SERVICE_URL_CANVAS_LAYOUT=http://127.0.0.1:8092
# SERVICE_URL_STUDIO=http://127.0.0.1:8093

# The Warehouse (not in the sovereign build): the cell's siloes project and region, the
# service accounts that alone write Warehouse datasets, where new projects go, intervals.
# BIGQUERY_PROJECT_ID=  BIGQUERY_LOCATION=europe-west2
# WAREHOUSE_WRITER_MEMBERS=serviceAccount:siloes-capture@PROJECT.iam.gserviceaccount.com
# WAREHOUSE_FOLDER_ID=  WAREHOUSE_BILLING_ACCOUNT_ID=
# WAREHOUSE_SYNC_INTERVAL_SECONDS=3600  WAREHOUSE_RECONCILE_INTERVAL_SECONDS=86400  WAREHOUSE_RECONCILE_SAMPLE=50  WAREHOUSE_BATCH_ROWS=500
# WAREHOUSE_ACCESS_CHECK_SECONDS=300 (how often live direct SQL grants are checked against markings)
# Import rows and the Object Index (spec 68.6, 69): IMPORT_LOADER_MAX_ROWS=10000  OBJECT_INDEX_TICK_SECONDS=60  OBJECT_INDEX_MAX_RESULTS=100
# BigQuery metering (spec 74.1): the cell region's list prices in pounds. Required by bigquery-metering; no default.
# BIGQUERY_PRICE_PER_TIB_SCANNED=  BIGQUERY_PRICE_PER_GIB_MONTH_STORED=  BIGQUERY_METERING_INTERVAL_SECONDS=86400

# Model gateway: routes per role, zero retention and inside the residency. A route may name
# its provider's "pricing" (pounds per million input and output tokens) so each call records
# its provider cost (D106); an embedding route sets "dimensions" and "embedBatch" (D103).
# MODEL_ROUTES_FILE=/path/to/model-routes.json
# Compile narrows a vocabulary larger than this many object types by description embeddings (D103).
# COMPILE_NARROW_TYPES=20
# The change-stream class (conformance, D104): how long to wait for each change, how often to look.
# CONFORMANCE_STREAM_WAIT_MS=120000  CONFORMANCE_STREAM_POLL_MS=2000

# Billing (not in the sovereign build): the payment provider's API and webhook secret.
# PAYMENTS_API_URL=  PAYMENTS_API_KEY=  PAYMENTS_WEBHOOK_SECRET=
# PAYMENTS_PRICE_STANDARD_MONTHLY=  PAYMENTS_PRICE_STANDARD_ANNUAL=
# PAYMENTS_PRICE_BUSINESS_MONTHLY=  PAYMENTS_PRICE_BUSINESS_ANNUAL=

# Enterprise contracts (billing): the margin floor calculator's floor and prices, and the
# sweeps of renewals, overdue invoices, overage and the closed month's Silo charges at cost
# plus 10% (D105). These are this build's defaults; the
# spec states the calculator's terms, not their prices (74.4).
# BILLING_MARGIN_FLOOR=0.6
# BILLING_COMPILE_PRICE_PER_MILLION_TOKENS=1.03
# BILLING_ESTIMATED_TOKENS_PER_COMPILE=15000
# BILLING_SIMULATION_UNIT_COST=0.50
# BILLING_STORAGE_COST_PER_GIB_MONTH=0.02
# BILLING_RENEWAL_NOTICE_DAYS=90
# BILLING_SWEEP_SECONDS=3600
# Auto top-up (73.4): the most automatic purchases per membership per day (D108).
# BILLING_AUTO_TOPUPS_PER_DAY=5

# Global tier (outside every cell): directory keys, the status page, release signing.
# KMS_DIRECTORY_KEY_URI=  DIRECTORY_KEY_VERSION=1
# DIRECTORY_PUBLIC_PORT=  DIRECTORY_PUBLIC_ORIGINS=
# STATUS_PUBLISH_DIR=/tmp/silo-status
# FLEET_ARTEFACT_DIR=/tmp/silo-fleet  FLEET_SIGNING_KEY_FILE=  FLEET_RELEASE_PUBLIC_KEY_FILE=
# Inside a cell, fleet-control runs as the cell's Fleet agent: it pulls the agent channel from the
# global one (SERVICE_URL_FLEET_CONTROL) and needs the release key and OBJECT_BUCKET_FILES.
# FLEET_ROLE=cell_agent  FLEET_AGENT_POLL_MINUTES=15
# A sovereign cell also checks its agent-sovereign heads against FLEET_SOVEREIGN_PUBLIC_KEY_FILE (D202).
# Given the cell's Kubernetes API it applies the cell's own releases too (spec 11.1 to 11.3):
# FLEET_KUBERNETES=in_cluster  FLEET_IMAGE_REPOSITORY=europe-west2-docker.pkg.dev/silo/cells
# FLEET_CHANNEL=stable  FLEET_RELEASE_POLL_MINUTES=5  FLEET_MIGRATION_SECRET=silo-migrate  FLEET_ROLL_TIMEOUT_MINUTES=15
# FLEET_GATE_WINDOW_MINUTES=15  (every process with SERVICE_URL_FLEET_CONTROL reports its health signals to the agent)
# The synthetic tests: FLEET_SYNTHETIC_PORT=8090  FLEET_SYNTHETIC_URL=https://synthetic.<cell host>  FLEET_GATEWAY_URL=http://gateway:8443
# FLEET_GATEWAY_ORIGIN=https://<cell host>  FLEET_SYNTHETIC_MINUTES=10
# Registration, status, change policy and Fleet's events: FLEET_CELL_STATUS=active  FLEET_REPORT_SECONDS=60
# (outside a pod: FLEET_KUBERNETES=https://...  FLEET_KUBERNETES_TOKEN_FILE=  FLEET_KUBERNETES_CA_FILE=  FLEET_KUBERNETES_NAMESPACE=)

LOG_LEVEL=debug

# Siloes Capture and Import (spec 67, 68, 70): intervals, the largest upload, and the region's
# prices for Capture's Postgres bytes and Import's object-storage bytes (required by each; no default).
# SILOES_CAPTURE_DRAIN_SECONDS=5  SILOES_PURGE_POLL_SECONDS=10  SILOES_RETENTION_SWEEP_SECONDS=86400
# SILOES_IMPORT_PROCESS_SECONDS=10  SILOES_IMPORT_MAX_FILE_BYTES=26214400
# SILOES_POSTGRES_PRICE_PER_GIB_MONTH=  SILOES_STORAGE_PRICE_PER_GIB_MONTH=  OBJECT_BUCKET_SILOES=

# Tenant migrations (spec 6.4): the credential service's import key, which another cell seals
# a migration to (local:<label> here; a Cloud KMS RSA_DECRYPT_OAEP_*_SHA256 key version in
# production). tenant-migrations runs with the platform workers and also needs
# MAINTENANCE_DATABASE_URL, OBJECT_BUCKET_BACKUP and OBJECT_BUCKET_FILES; it moves an
# organisation only with SERVICE_URL_DIRECTORY set.
# KMS_IMPORT_KEY_URI=local:import  TENANT_MIGRATIONS_TICK_SECONDS=30  OBJECT_BUCKET_BACKUP=silo-backup

# The organisation export (spec 2.6): how often requested exports start, and the largest bundle
# (built in memory).
# ORG_EXPORT_TICK_SECONDS=30  ORG_EXPORT_MAX_BYTES=2147483648

# The AI FDE (spec 49 to 54): how often the orchestrator looks at its engagements, and the
# model provider's price in pounds per million tokens on the fde route, for provider cost
# (52.6). With no price, provider cost reads 0. Its model calls go through model-gateway's
# fde route (MODEL_ROUTES_FILE).
# FDE_TICK_SECONDS=15  FDE_PROVIDER_PRICE_INPUT_PER_MILLION=  FDE_PROVIDER_PRICE_OUTPUT_PER_MILLION=

# The admin portal (spec 13): the staff console's own listener, and the staff identity
# provider that alone signs staff in. The ID token's amr must name every required method
# (hwk: a hardware key) and carry every device claim (required in the sovereign build).
# Groups map to staff capabilities (contracts/admin-portal/capability); use _FILE for a file.
# ADMIN_PORTAL_PUBLIC_ORIGIN=https://staff.uk-lon-1.silohq.io  ADMIN_PORTAL_PUBLIC_PORT=8444
# ADMIN_PORTAL_TLS_CERT_FILE=  ADMIN_PORTAL_TLS_KEY_FILE=
# ADMIN_PORTAL_IDP_ISSUER=  ADMIN_PORTAL_IDP_CLIENT_ID=  ADMIN_PORTAL_IDP_CLIENT_SECRET=  ADMIN_PORTAL_IDP_REDIRECT_URI=
# ADMIN_PORTAL_IDP_REQUIRED_AMR=hwk  ADMIN_PORTAL_IDP_GROUPS_CLAIM=groups
# ADMIN_PORTAL_GROUP_CAPABILITIES={"silo-support":["access.request"],"silo-security":["access.approve"]}
# ADMIN_PORTAL_DEVICE_CLAIMS={"device_managed":true}
# ADMIN_PORTAL_SESSION_IDLE_MINUTES=15  ADMIN_PORTAL_SESSION_ABSOLUTE_MINUTES=480  ADMIN_PORTAL_SWEEP_SECONDS=60
